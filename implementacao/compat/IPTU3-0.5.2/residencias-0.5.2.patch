+  }
+  async function step(){
+    if(busy)return;busy=true;
+    try{
+      const tours=await transact(async conn=>{const [rows]=await conn.query("SELECT * FROM aetherius_residence_tours WHERE state<>'closed' ORDER BY created_at");return rows;});
